# ============================================================================
# Importação do ERP (dados reais → Supabase). Copie o necessário para .env.local
# (o .env.local é IGNORADO pelo Git — nunca comite a service_role key).
#
# A SUPABASE_URL já existe no .env (não é segredo). Você só precisa adicionar a
# service_role key do seu projeto Supabase em .env.local:
#
#   SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
#
# Depois rode:  npm run import:erp -- "/caminho/para/dados.txt"
# (a service_role ignora RLS para a carga administrativa; use SOMENTE local.)
# ============================================================================

# SUPABASE_URL=https://SEU-PROJETO.supabase.co        # já vem do .env
# SUPABASE_SERVICE_ROLE_KEY=                            # <- coloque em .env.local
# ERP_FILE=/caminho/para/dados.txt                     # opcional (alternativa ao argumento)
